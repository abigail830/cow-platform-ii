# Copy to .env and edit.
# Full variable list: openkms_cli/settings.py and docs/features/configuration.md
# Worker jobs spawn with cwd=openkms-cli; credentials live here (not injected from backend).

# --- Auth: local | oidc (must match backend OPENKMS_AUTH_MODE) ---
OPENKMS_AUTH_MODE=local
OPENKMS_CLI_BASIC_USER=openkms-cli
OPENKMS_CLI_BASIC_PASSWORD=change-me

# OIDC (when OPENKMS_AUTH_MODE=oidc) — see docs/features/console-and-auth.md
# OPENKMS_OIDC_TOKEN_URL=http://localhost:8081/realms/openkms/protocol/openid-connect/token
# OPENKMS_CLI_OIDC_CLIENT_ID=openkms-cli
# OPENKMS_CLI_OIDC_CLIENT_SECRET=

# --- Backend API (document-parse defaults, kb-index, metadata) ---
OPENKMS_API_URL=http://localhost:8102

# --- MinIO / S3 ---
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://localhost:9000
AWS_BUCKET_NAME=openkms
AWS_REGION=us-east-1

# --- Document parse: standalone (--vlm-url + --model) or lookup by display name ---
OPENKMS_VLM_URL=http://localhost:8101
OPENKMS_VLM_MODEL=PaddlePaddle/PaddleOCR-VL-1.6
# OPENKMS_VLM_API_KEY=
# OPENKMS_VLM_CONFIG_NAME=My VLM entry

# --- Baidu doc-parse pipeline (optional) ---
OPENKMS_BAIDU_CLOUD_API_KEY=
OPENKMS_BAIDU_CLOUD_SECRET_KEY=
OPENKMS_BAIDU_BOS_BUCKET=
OPENKMS_BAIDU_BOS_ACCESS_KEY=
OPENKMS_BAIDU_BOS_SECRET_KEY=

BAIDU_TOKEN_URL=https://aip.baidubce.com/oauth/2.0/token
BAIDU_TASK_URL=https://aip.baidubce.com/rest/2.0/brain/online/v2/paddle-vl-parser/task
BAIDU_QUERY_URL=https://aip.baidubce.com/rest/2.0/brain/online/v2/paddle-vl-parser/task/query

# --- Aliyun Document Mind (aliyun-docmind-parse pipeline) ---
OPENKMS_DOCMIND_ENDPOINT=docmind-api.cn-hangzhou.aliyuncs.com
# OPENKMS_DOCMIND_ENABLE_EVENT_CALLBACK=false
# OPENKMS_OSS_PRESIGN_TTL_SECONDS=3600

# Async platform jobs (pipeline run-async): poll cloud until parse completes
# OPENKMS_ASYNC_POLL_INTERVAL_SECONDS=8
# OPENKMS_ASYNC_MAX_WAIT_SECONDS=600

# --- Adobe PDF Services (paddleocr-doc-parse: Office → PDF before VLM parse) ---
# OPENKMS_ADOBE_CLIENT_ID=
# OPENKMS_ADOBE_CLIENT_SECRET=
# ADOBE_CLIENT_ID=          # alias for OPENKMS_ADOBE_CLIENT_ID
# ADOBE_CLIENT_SECRET=      # alias for OPENKMS_ADOBE_CLIENT_SECRET
# OPENKMS_ADOBE_API_BASE=https://pdf-services.adobe.io
# OPENKMS_ADOBE_POLL_INTERVAL_SECONDS=3
# OPENKMS_ADOBE_MAX_WAIT_SECONDS=300