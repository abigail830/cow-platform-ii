# Copy to .env or symlink ../openkms-cli/.env
# Same variables as openkms-cli (auth, API URL, OSS, ASR keys).

OPENKMS_AUTH_MODE=local
OPENKMS_CLI_BASIC_USER=openkms-cli
OPENKMS_CLI_BASIC_PASSWORD=change-me
OPENKMS_API_URL=http://localhost:8787

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1
