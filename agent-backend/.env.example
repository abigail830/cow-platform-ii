# Neon Postgres (Flue persistence + app tables)
# First-time: cp .env.example .env, set DATABASE_URL, then run: npm run setup
#
# Local overrides (not committed): copy values you want to override into .env.local
# e.g. PIPELINE_WORKER=spawn — loaded after .env and wins on conflict.
DATABASE_URL=

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# OKF bundle — local dev (monorepo sibling or clone)
OKF_BUNDLE_PATH=../smart-proposal-knowledge

# Vercel build:vendor from GitHub (defaults shown; optional overrides)
# OKF_BUNDLE_GIT_REPO=abigail830/okf-knowledge-bundle
# OKF_BUNDLE_GIT_REF=main
# OKF_BUNDLE_GIT_SUBDIR=smart-proposal-knowledge
# Offline / monorepo build:vercel without fetch:
# OKF_BUNDLE_LOCAL_PATH=../smart-proposal-knowledge

# Model profile: azure-openai | openai | anthropic | siliconflow
MODEL_PROFILE=azure-openai

# Azure OpenAI (Responses API — uses api-version=v1 automatically)
AZURE_API_KEY=
AZURE_OPENAI_BASE_URL=https://YOUR_RESOURCE.cognitiveservices.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# OpenAI direct (when MODEL_PROFILE=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (when MODEL_PROFILE=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=anthropic/claude-sonnet-4-20250514

# SiliconFlow (when MODEL_PROFILE=siliconflow)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

# E2B sandbox (optional; adapter at src/sandboxes/e2b.ts)
E2B_API_KEY=

# Server
PORT=8787
CORS_ORIGIN=http://localhost:5180
# On Vercel: set to your backend deployment URL (GHA + CLI callbacks)
OPENKMS_API_URL=http://127.0.0.1:8787

# Internal API auth for openkms-cli and pipeline worker (HTTP Basic)
OPENKMS_CLI_BASIC_USER=openkms-cli
OPENKMS_CLI_BASIC_PASSWORD=

# Pipeline worker: spawn (local CLI subprocess) | github_actions (Vercel / serverless)
# On Vercel, defaults to github_actions when unset.
PIPELINE_WORKER=spawn
# GitHub Actions dispatch (when PIPELINE_WORKER=github_actions)
GITHUB_PIPELINE_TOKEN=
GITHUB_PIPELINE_REPOSITORY=abigail830/cow-platform-ii
GITHUB_PIPELINE_WORKFLOW=openkms-pipeline.yml
GITHUB_PIPELINE_REF=main
# Long-lived Node only (auto-disabled on Vercel):
# PIPELINE_STARTUP_RECOVERY=true
# PIPELINE_POLL_SCHEDULER=true

# Baidu doc-parse pipeline (baidu-doc-parse) — from 百度智能云 → 文字识别 → 文档解析 → 应用管理
OPENKMS_BAIDU_CLOUD_API_KEY=
OPENKMS_BAIDU_CLOUD_SECRET_KEY=
# Private BOS bucket for temporary staging (presigned file_url to Baidu API)
OPENKMS_BAIDU_BOS_BUCKET=
# IAM Access Key (安全认证 → Access Key), NOT the OCR API Key above
OPENKMS_BAIDU_BOS_ACCESS_KEY=
OPENKMS_BAIDU_BOS_SECRET_KEY=
# Optional BOS region host, e.g. bj.bcebos.com
# OPENKMS_BAIDU_BOS_ENDPOINT=bj.bcebos.com
# OPENKMS_BAIDU_BOS_PREFIX=openkms-temp

# --- Aliyun Document Mind (aliyun-docmind-parse pipeline) ---
# Uses AWS_* credentials for OSS presigned FileUrl + Document Mind API
OPENKMS_DOCMIND_ENDPOINT=docmind-api.cn-hangzhou.aliyuncs.com
# OPENKMS_DOCMIND_ENABLE_EVENT_CALLBACK=false
# OPENKMS_OSS_PRESIGN_TTL_SECONDS=3600

# S3-compatible object storage (AWS S3, Aliyun OSS, MinIO, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1
# Optional custom endpoint (e.g. https://oss-cn-shenzhen.aliyuncs.com or http://localhost:9000)
AWS_ENDPOINT_URL=
# Set to true for MinIO and most path-style endpoints
AWS_S3_FORCE_PATH_STYLE=false
