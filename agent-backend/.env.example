# Neon Postgres (Flue persistence + app tables)
# First-time: cp .env.example .env, set DATABASE_URL, then run: npm run setup
#
# Local overrides (not committed): copy values you want to override into .env.local
# e.g. PIPELINE_WORKER=spawn — loaded after .env and wins on conflict.
DATABASE_URL=

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Seal model config provider API keys at rest (AES-256-GCM). Falls back to JWT_SECRET if unset.
# MODEL_CONFIG_SECRET_KEY=change-me-model-secrets
# Optional: signed ?token= on agent attachment download URLs (defaults to JWT_EXPIRES_IN)
# ATTACHMENT_TOKEN_EXPIRES_IN=7d

# Model profile fallback when agent.yaml has no configName:
# - legacy env profiles: azure-openai | openai | anthropic | siliconflow
# - catalog config names: glm-4.7-flash (default), qwen3.7-flash, ...
MODEL_PROFILE=glm-4.7-flash

# Azure OpenAI (Responses API — uses api-version=v1 automatically)
AZURE_API_KEY=
AZURE_OPENAI_BASE_URL=https://YOUR_RESOURCE.cognitiveservices.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# OpenAI direct (when MODEL_PROFILE=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (when MODEL_PROFILE=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=anthropic/claude-sonnet-4-20250514

# SiliconFlow (when MODEL_PROFILE=siliconflow)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

# E2B sandbox (optional; platform lifecycle in src/sandboxes/)
E2B_API_KEY=
# Idle TTL for running sandboxes — refreshed on connect/use; on expiry E2B kills (default 300000 = 5m)
E2B_SESSION_TIMEOUT_MS=300000
# Custom template alias (build once: npm run e2b:build-content-studio-template)
# E2B_CONTENT_STUDIO_TEMPLATE=okf-content-studio
# E2B_CONTENT_STUDIO_TEMPLATE_TAG=1.0

# Zhipu web search MCP (Knowledge Q&A agent — web_search_prime)
# API key: https://open.bigmodel.cn/usercenter/apikeys
# Docs: https://docs.bigmodel.cn/cn/coding-plan/mcp/search-mcp-server
ZHIPU_WEB_SEARCH_MCP_URL=https://open.bigmodel.cn/api/mcp/web_search_prime/mcp
ZHIPU_API_KEY=Bearer YOUR_ZHIPU_API_KEY

# Hybrid-search MCP (Knowledge Q&A — list_knowledge_bases / hybrid_search)
# Same contract as external MCP clients (Cursor, etc.): full URL + Bearer okf_ API key.
# Local default when unset: {OPENKMS_API_URL}/api/mcp/hybrid-search
HYBRID_SEARCH_MCP_URL=http://127.0.0.1:8787/api/mcp/hybrid-search
HYBRID_SEARCH_MCP_API_KEY=Bearer okf_YOUR_API_KEY

# Session file attachments (playground documents + paperclip images)
SESSION_FILES_BACKEND=local
# Default (when unset): <repo>/.run/session-attachments — outside agent-backend so flue dev watch is not triggered on upload.
# SESSION_FILES_ROOT=/absolute/path/to/session-attachments
# Optional: force a VLM model config name for paperclip image extract.
# When unset, uses Model Config default where apiType=vlm and isDefault=true.
# SESSION_FILE_VISION_MODEL=paddleocr-vl-1.5
# Vercel Blob (when SESSION_FILES_BACKEND=blob)
BLOB_READ_WRITE_TOKEN=

CORS_ORIGIN=http://localhost:5180
# On Vercel: set to your backend deployment URL (GHA + CLI callbacks)
OPENKMS_API_URL=http://127.0.0.1:8787

# Agent-to-Agent (A2A) — exposes /api/channels/{agentId}-a2a/* for agents with `a2a:` in agent.yaml
# A2A_API_KEY=change-me-a2a-key
# Optional override for Flue prompt calls (defaults to seeded a2a-service@internal user)
# A2A_SERVICE_USER_ID=
# Optional public base URL when OPENKMS_API_URL is unset (agent card interface URL)
# A2A_PUBLIC_BASE_URL=http://127.0.0.1:8787

# Internal API auth for openkms-cli and pipeline worker (HTTP Basic)
OPENKMS_CLI_BASIC_USER=openkms-cli
OPENKMS_CLI_BASIC_PASSWORD=

# Pipeline worker: spawn (local CLI subprocess) | github_actions (Vercel / serverless)
# On Vercel, defaults to github_actions when unset.
PIPELINE_WORKER=spawn
# GitHub Actions dispatch (when PIPELINE_WORKER=github_actions)
GITHUB_PIPELINE_TOKEN=
GITHUB_PIPELINE_REPOSITORY=abigail830/cow-platform-ii
GITHUB_PIPELINE_WORKFLOW=openkms-pipeline.yml
GITHUB_PIPELINE_REF=main

# PageIndex KB import worker (isolated from document parse pipeline)
# KB_IMPORT_WORKER=spawn | github_actions (defaults: spawn locally, github_actions on Vercel)
# Legacy fallback: KB_PAGEINDEX_IMPORT_WORKER
# GITHUB_KB_IMPORT_WORKFLOW=openkms-kb-pageindex-import.yml
# Legacy fallback: GITHUB_KB_PAGEINDEX_IMPORT_WORKFLOW

# Long-lived Node only (auto-disabled on Vercel):
# PIPELINE_STARTUP_RECOVERY=true
# PIPELINE_POLL_SCHEDULER=true

# Baidu doc-parse pipeline (baidu-doc-parse) — from 百度智能云 → 文字识别 → 文档解析 → 应用管理
OPENKMS_BAIDU_CLOUD_API_KEY=
OPENKMS_BAIDU_CLOUD_SECRET_KEY=
# Private BOS bucket for temporary staging (presigned file_url to Baidu API)
OPENKMS_BAIDU_BOS_BUCKET=
# IAM Access Key (安全认证 → Access Key), NOT the OCR API Key above
OPENKMS_BAIDU_BOS_ACCESS_KEY=
OPENKMS_BAIDU_BOS_SECRET_KEY=
# Optional BOS region host, e.g. bj.bcebos.com
# OPENKMS_BAIDU_BOS_ENDPOINT=bj.bcebos.com
# OPENKMS_BAIDU_BOS_PREFIX=openkms-temp

# --- Aliyun Document Mind (aliyun-docmind-parse pipeline) ---
# Uses AWS_* credentials for OSS presigned FileUrl + Document Mind API
OPENKMS_DOCMIND_ENDPOINT=docmind-api.cn-hangzhou.aliyuncs.com
# OPENKMS_DOCMIND_ENABLE_EVENT_CALLBACK=false
# OPENKMS_OSS_PRESIGN_TTL_SECONDS=3600

# S3-compatible object storage (AWS S3, Aliyun OSS, MinIO, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1
# Optional custom endpoint (e.g. https://oss-cn-shenzhen.aliyuncs.com or http://localhost:9000)
AWS_ENDPOINT_URL=
# Set to true for MinIO and most path-style endpoints
AWS_S3_FORCE_PATH_STYLE=false
