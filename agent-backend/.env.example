# Application PostgreSQL
# First-time: cp .env.example .env, set DATABASE_URL, then run: npm run setup
#
# Local overrides (not committed): .env.local wins over .env
DATABASE_URL=

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Seal model config API keys at rest (AES-256-GCM). Falls back to JWT_SECRET if unset.
# MODEL_CONFIG_SECRET_KEY=change-me-model-secrets

# LLM provider keys live in Admin → Model Configuration (DB), not in env.

# Browser CORS (frontend origin)
CORS_ORIGIN=http://localhost:5180
# Public backend URL — GHA workers and openkms-cli callbacks
OPENKMS_API_URL=http://127.0.0.1:8787

# Internal API auth (openkms-cli + pipeline workers)
OPENKMS_CLI_BASIC_USER=openkms-cli
OPENKMS_CLI_BASIC_PASSWORD=

# Pipeline worker: spawn (local) | github_actions (Vercel default when VERCEL is set)
PIPELINE_WORKER=spawn
GITHUB_PIPELINE_TOKEN=
GITHUB_PIPELINE_REPOSITORY=abigail830/cow-platform-ii
# GITHUB_PIPELINE_WORKFLOW=openkms-pipeline.yml
# GITHUB_AUDIO_PIPELINE_WORKFLOW=openkms-audio-transcribe.yml
# GITHUB_AUDIO_CAPTURE_PIPELINE_WORKFLOW=openkms-audio-capture-post-process.yml
# GITHUB_EVAL_PIPELINE_WORKFLOW=evaluate-pipeline.yml
# GITHUB_KB_IMPORT_WORKFLOW=openkms-kb-pageindex-import.yml
# GITHUB_PIPELINE_REF=main
# KB_IMPORT_WORKER=spawn

# Long-lived Node only (auto-disabled on Vercel):
# PIPELINE_STARTUP_RECOVERY=true
# PIPELINE_POLL_SCHEDULER=true

# S3-compatible object storage (Aliyun OSS, AWS S3, MinIO, …)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1
# AWS_ENDPOINT_URL=https://oss-cn-shenzhen.aliyuncs.com
# AWS_S3_FORCE_PATH_STYLE=false

# --- Pipeline CLI secrets (local spawn only) ---
# When PIPELINE_WORKER=spawn, openkms-cli reads these from the same shell env.
# On Vercel/GHA, set them as GitHub Actions secrets instead — see openkms-cli/.env.example
# OPENKMS_BAIDU_CLOUD_API_KEY=
# OPENKMS_BAIDU_CLOUD_SECRET_KEY=
# OPENKMS_BAIDU_BOS_BUCKET=
# OPENKMS_BAIDU_BOS_ACCESS_KEY=
# OPENKMS_BAIDU_BOS_SECRET_KEY=
# OPENKMS_DOCMIND_ENDPOINT=docmind-api.cn-hangzhou.aliyuncs.com

# --- Optional tuning ---
# OPENKMS_CLI_BIN=/path/to/openkms-cli
# EVALUATE_CLI_BIN=/path/to/evaluate-cli
# SYNC_AGENT_TIMEOUT_MS=120000
# PG_POOL_MAX=10
