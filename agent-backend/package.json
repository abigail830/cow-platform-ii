    "@types/node": "^26.1.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3"
