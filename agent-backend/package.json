{
  "name": "agent-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev-server.ts",
    "build": "npm run build:vercel",
    "build:vercel": "node scripts/build-vercel.mjs",
    "start": "tsx scripts/dev-server.ts",
    "db:generate": "drizzle-kit generate",
    "db:validate-migrations": "tsx scripts/validate-migrations.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate-knowledge-captures": "tsx scripts/migrate-knowledge-to-captures.ts",
    "setup": "npm run db:migrate && npm run seed",
    "seed": "tsx scripts/seed-users.ts",
    "seed:rbac": "tsx scripts/seed-rbac.ts",
    "verify": "tsx scripts/verify-smoke.ts",
    "verify:documents": "tsx scripts/verify-documents.ts",
    "verify:knowledge-bases": "tsx scripts/verify-knowledge-bases.ts",
    "verify:eval-pipeline-dispatch": "tsx scripts/verify-eval-pipeline-dispatch.ts",
    "verify:resource-access": "tsx scripts/verify-resource-access.ts",
    "verify:user-api-key": "tsx scripts/verify-user-api-key.ts",
    "test": "tsx --test src/**/*.test.ts",
    "test:openapi": "tsx --test src/apis/openapi/openapi.test.ts",
    "test:documents": "tsx --test src/document/infrastructure/document-files.test.ts src/document/domain/channel-tree.test.ts && tsx scripts/verify-documents.ts"
  },
