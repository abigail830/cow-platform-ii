    "@flue/runtime": "1.0.0-beta.9",
    "@flue/sdk": "1.0.0-beta.9",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "e2b": "^2.36.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.32",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
