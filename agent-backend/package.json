{
  "name": "agent-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "catalog:sync": "node scripts/sync-catalog-agents.mjs",
    "catalog:validate": "tsx scripts/validate-agent-catalog.ts",
    "catalog:vendor-content-skills": "node scripts/vendor-content-studio-skills.mjs",
    "predev": "npm run catalog:sync",
    "prebuild": "npm run catalog:sync",
    "dev": "tsx scripts/flue-with-env.ts dev --target node --env .env --port 8787",
    "build": "tsx scripts/flue-with-env.ts build --target node --env .env",
    "build:vercel": "npm run catalog:sync && node scripts/build-vercel.mjs",
    "start": "tsx scripts/flue-with-env.ts run --target node --env .env",
    "db:generate": "drizzle-kit generate",
    "db:validate-migrations": "tsx scripts/validate-migrations.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset-flue": "tsx scripts/reset-flue-tables.ts",
    "setup": "npm run db:migrate && npm run seed",
    "seed": "tsx scripts/seed-users.ts",
    "seed:rbac": "tsx scripts/seed-rbac.ts",
    "verify": "npm run catalog:validate && tsx scripts/verify-smoke.ts",
    "verify:documents": "tsx scripts/verify-documents.ts",
    "verify:knowledge-bases": "tsx scripts/verify-knowledge-bases.ts",
    "verify:resource-access": "tsx scripts/verify-resource-access.ts",
    "verify:user-api-key": "tsx scripts/verify-user-api-key.ts",
    "test": "tsx --test src/**/*.test.ts",
    "test:documents": "tsx --test src/storage/document-files.test.ts src/services/channel-tree.test.ts && tsx scripts/verify-documents.ts",
    "e2b:build-content-studio-template": "tsx e2b-templates/content-studio/build.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.0.1",
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@flue/cli": "1.0.0-beta.9",
    "@flue/postgres": "1.0.0-beta.9",
    "@flue/runtime": "1.0.0-beta.9",
    "@flue/sdk": "1.0.0-beta.9",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "e2b": "^2.36.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.32",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "valibot": "^1.4.2",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3"
  }
}
