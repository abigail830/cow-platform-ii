    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@hono/standard-validator": "^0.4.0",
    "@hono/swagger-ui": "^0.6.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vercel/blob": "^2.6.1",
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.32",
    "hono-openapi": "^1.3.2",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "officeparser": "^7.5.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "valibot": "^1.4.2",
    "xlsx": "^0.18.5",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
