# sse (default) or long-poll if corporate proxy blocks SSE
VITE_FLUE_LIVE_MODE=sse

# Production (Vercel): browser calls backend directly — required for agent chat.
# Backend project URL, no trailing slash. Local dev: leave unset (Vite proxy).
VITE_API_ORIGIN=https://cow-platform-ii.vercel.app

# Optional legacy Edge proxy (not used when VITE_API_ORIGIN is set in the build)
# BACKEND_ORIGIN=https://cow-platform-ii.vercel.app
