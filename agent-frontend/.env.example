# sse (default) or long-poll if corporate proxy blocks SSE
VITE_FLUE_LIVE_MODE=sse

# Local dev: do NOT set VITE_API_ORIGIN (use Vite proxy in vite.config.ts).
# Production: set in .env.production or Vercel env (see DEPLOY.md).
# VITE_API_ORIGIN=https://cow-platform-ii.vercel.app

# Vercel legacy Edge proxy only (optional if not using VITE_API_ORIGIN):
# BACKEND_ORIGIN=https://cow-platform-ii.vercel.app
