# --- Azure OpenAI (recommended if you use Azure) ---
AZURE_API_KEY=
AZURE_API_BASE=https://YOUR_RESOURCE.openai.azure.com/
AZURE_API_VERSION=2024-08-01-preview
AZURE_DEPLOYMENT_NAME=gpt-4o

# LiteLLM routes azure/* models using the vars above.

# --- Anthropic (alternative) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- OpenAI direct (alternative) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Optional explicit model override for stream_cli.py --model
# LITELLM_MODEL=azure/gpt-4o
